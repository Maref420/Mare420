# syntax=docker/dockerfile:1
# GOVERNANCE: Matrix A - Rust Compute Layer
# Multi-stage build for atlas-ipc-server.

FROM rust:1.82.0-slim AS builder
WORKDIR /workspace
COPY core_engine/risk/Cargo.toml core_engine/risk/src/ ./core_engine/risk/
COPY core_engine/ipc_server/Cargo.toml core_engine/ipc_server/src/ ./core_engine/ipc_server/
# Create dummy lib.rs to satisfy cargo check during dependency resolution
RUN cd core_engine/risk && mkdir -p src && \
    [ -f src/lib.rs ] || echo "// placeholder" > src/lib.rs
RUN cd core_engine/ipc_server && cargo build --release 2>/dev/null || true
# Now copy real source and rebuild
COPY core_engine/risk/ ./core_engine/risk/
COPY core_engine/ipc_server/ ./core_engine/ipc_server/
RUN cd core_engine/ipc_server && cargo build --release

FROM alpine:3.20.3
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 atlas && adduser -u 1000 -G atlas -D atlas
COPY --from=builder /workspace/core_engine/ipc_server/target/release/atlas-ipc-server /usr/local/bin/atlas-ipc-server
RUN mkdir -p /app/uds && chown -R atlas:atlas /app
USER atlas:atlas
WORKDIR /app

ENV IPC_SOCKET_PATH=/app/uds/atlas-ipc.sock
ENV RUST_LOG=info
ENV TZ=Etc/UTC

LABEL org.opencontainers.image.description="Atlas IPC Server (Risk Engine)" \
      org.opencontainers.image.source="https://github.com/atlas-ai/infrastructure"

VOLUME /app/uds

# No HEALTHCHECK — UDS-only service, no HTTP port.

CMD ["/usr/local/bin/atlas-ipc-server"]
