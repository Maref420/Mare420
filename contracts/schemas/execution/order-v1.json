{
  "version": "1.1",
  "type": "model-contract",
  "purpose": "Define structure for trade orders sent to exchanges",
  "required_fields": [
    "order_id",
    "symbol",
    "side",
    "quantity",
    "order_type",
    "timestamp",
    "agent_id"
  ],
  "optional_fields": [
    "price",
    "stop_price",
    "time_in_force",
    "metadata"
  ],
  "field_types": {
    "order_id": "uuid",
    "symbol": "string(min_length=1)",
    "side": "enum(buy,sell)",
    "quantity": "integer(gt=0)",
    "order_type": "enum(market,limit,stop_limit,stop_market)",
    "price": "integer(gt=0)|null",
    "stop_price": "integer(gt=0)|null",
    "time_in_force": "enum(gtc,ioc,fok,gtd)|null",
    "timestamp": "datetime(auto_now)",
    "agent_id": "string(min_length=1)",
    "metadata": "dict[string,any](default={})"
  },
  "rules": {
    "extra_fields": "forbid",
    "immutable_after_submission": true,
    "audit_required_on_creation": true,
    "risk_check_required_before_submission": true,
    "price_required_for_limit_orders": true
  },
  "ownership": {
    "owner": "Execution Engine",
    "unauthorized_modification": "prohibited",
    "last_deterministic_migration": "2026-08-30",
    "migration_reason": "Compliance with rust-policy.yaml deterministic_processing_required"
  },
  "notes": {
    "quantity": "Migrated float(gt=0) \u2192 integer(gt=0). Scaled to smallest asset unit per exchange config",
    "price": "Migrated float(gt=0)|null \u2192 integer(gt=0)|null. Scaled to smallest currency unit per exchange config",
    "stop_price": "Migrated float(gt=0)|null \u2192 integer(gt=0)|null. Scaled to smallest currency unit per exchange config"
  }
}
