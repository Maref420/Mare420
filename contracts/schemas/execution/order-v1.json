{
  "version": "1.0",
  "type": "model-contract",
  "purpose": "Define structure for trade orders sent to exchanges",
  "required_fields": ["order_id", "symbol", "side", "quantity", "order_type", "timestamp", "agent_id"],
  "optional_fields": ["price", "stop_price", "time_in_force", "metadata"],
  "field_types": {
    "order_id": "uuid",
    "symbol": "string(min_length=1)",
    "side": "enum(buy,sell)",
    "quantity": "float(gt=0)",
    "order_type": "enum(market,limit,stop_limit,stop_market)",
    "price": "float(gt=0)|null",
    "stop_price": "float(gt=0)|null",
    "time_in_force": "enum(gtc,ioc,fok,gtd)|null",
    "timestamp": "datetime(auto_now)",
    "agent_id": "string(min_length=1)",
    "metadata": "dict[string,any](default={})"
  },
  "rules": {
    "extra_fields": "forbid",
    "immutable_after_submission": true,
    "audit_required_on_creation": true,
    "risk_check_required_before_submission": true,
    "price_required_for_limit_orders": true
  },
  "ownership": {
    "owner": "Execution Engine",
    "unauthorized_modification": "prohibited"
  }
}
