{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas-ai.local/schemas/strategy/strategy-signal-event-v1.schema.json",
  "title": "StrategySignalEventV1",
  "description": "Contract for market strategy signals between Intelligence(Python), Broker(Go), and Engine(Rust)",
  "type": "object",
  "required": ["version", "event_id", "timestamp_utc", "source_agent", "signal"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "format": "uuid" },
    "source_agent": { "type": "string", "minLength": 1 },
    "signal": {
      "type": "object",
      "required": ["symbol", "direction", "confidence", "regime"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9]{2,20}$" },
        "direction": { "enum": ["LONG", "SHORT", "FLAT"] },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "regime": { "enum": ["TRENDING", "RANGING", "VOLATILE", "CALM"] },
        "parameters": { "type": "object" }
      }
    },
    "metadata": { "type": "object" }
  }
}
