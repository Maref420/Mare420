{
  "version": "1.0",
  "type": "model-contract",
  "purpose": "Pre-trade risk assessment result",
  "required_fields": ["assessment_id", "order_id", "approved", "assessed_at", "agent_id", "checks_performed"],
  "optional_fields": ["rejection_reason", "risk_score", "metadata"],
  "field_types": {
    "assessment_id": "uuid",
    "order_id": "uuid",
    "approved": "boolean",
    "assessed_at": "datetime(auto_now)",
    "agent_id": "string(min_length=1)",
    "checks_performed": "list[string](min_length=1)",
    "rejection_reason": "string|null",
    "risk_score": "float(ge=0,le=1)|null",
    "metadata": "dict[string,any](default={})"
  },
  "rules": {
    "extra_fields": "forbid",
    "immutable_after_creation": true,
    "audit_required": true,
    "rejection_reason_required_when_not_approved": true
  },
  "dependencies": {
    "order_id": "contracts/schemas/execution/order-v1.json"
  },
  "ownership": {
    "owner": "Risk Engine",
    "unauthorized_modification": "prohibited"
  }
}
